          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"tasks\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"description\" TEXT NULL, \"start_time\" INTEGER NOT NULL, \"end_time\" INTEGER NOT NULL, \"is_important\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_important\" IN (0, 1)), \"is_completed\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_completed\" IN (0, 1)), \"reminder_minutes\" INTEGER NULL, \"recurring_pattern\" TEXT NULL, \"recurring_template_id\" TEXT NULL, \"notes\" TEXT NULL, \"attachment_path\" TEXT NULL, \"color\" TEXT NULL, \"category\" TEXT NOT NULL DEFAULT 'none', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
