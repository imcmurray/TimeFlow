<?xml version="1.0" encoding="utf-8"?>
<!-- Android 13 and above (android:dataExtractionRules). Same reasoning as backup_rules.xml:
     the token is wrapped by a Keystore key that stays on this device, so copying it to
     another one produces a dead token and a device list that lies.

     device-transfer as well as cloud-backup: a direct phone-to-phone transfer has exactly
     the same problem. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="FlutterSecureStorage.xml" />
        <exclude domain="sharedpref" path="FlutterSecureStorageConfiguration.xml" />
    </device-transfer>
</data-extraction-rules>
